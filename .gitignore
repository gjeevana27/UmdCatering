__pycache__/
*.pyc
.env
.venv/
.streamlit/*
!.streamlit/secrets.toml.example
!.streamlit/config.toml
*.egg-info/
.DS_Store

# Firestore service-account credential — this is a real, sensitive key.
# Never commit it, whatever you name the downloaded file.
*service-account*.json
*firestore-credentials*.json
umdcatering-*.json

# Real document photos have client PII (names, phones, addresses) —
# never commit these. See data/real_examples/README.md.
data/real_examples/contracts/*
data/real_examples/pull_sheets/*
!data/real_examples/contracts/.gitkeep
!data/real_examples/pull_sheets/.gitkeep

# Ground-truth JSON for evaluate_extraction.py is typed by hand from those
# same real photos (event_id, location, guest counts, etc.) -- same PII
# concern, stays local too. The directory itself must be un-ignored before
# its own contents can be re-ignored (negating a path inside an already-
# excluded parent doesn't work), so this needs all three lines below, not
# just a `!...ground_truth/.gitkeep`.
!data/real_examples/contracts/ground_truth/
data/real_examples/contracts/ground_truth/*
!data/real_examples/contracts/ground_truth/.gitkeep
