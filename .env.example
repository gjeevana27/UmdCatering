# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored -- never committed, stays local to this machine.

# --- Gemini (extraction) ---
# Free, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Firestore (contract storage) ---
# Path to your service-account JSON file (keep it OUT of git -- already
# covered by .gitignore, but don't rename it into a tracked path).
FIRESTORE_CREDENTIALS_PATH=

# --- App passcode ---
# A single shared password gating access to app.py, since it may run on
# a public URL against your own Gemini/Firestore quota. Leave blank to
# disable (fine for local-only use).
APP_PASSCODE=

# --- Intake agent (intake_agent.py / start_intake_agent.bat) ---
# The folder intake_agent.py watches for contract files. Leave blank to
# use the default (an `intake\` folder created next to this file). Set
# this to point at wherever contracts actually get downloaded to on this
# machine, e.g.:
# INTAKE_FOLDER_PATH=C:\Good_to_Go
INTAKE_FOLDER_PATH=
